{
  "agents": ["claude-code", "codex", "opencode"],
  "mcps": [
    {
      "id": "figma",
      "label": "Figma — design context (OAuth on first use)",
      "transport": "http",
      "url": "https://mcp.figma.com/mcp",
      "headers": {},
      "env": []
    },
    {
      "id": "chrome-devtools",
      "label": "Chrome DevTools — inspect/debug a live browser",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env": []
    },
    {
      "id": "playwright",
      "label": "Playwright MCP — browser automation (Claude gets it via the official plugin)",
      "transport": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": [],
      "agents": ["codex", "opencode"]
    },
    {
      "id": "context7",
      "label": "Context7 — live library docs (Claude gets it via the official plugin)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": [],
      "agents": ["codex", "opencode"]
    },
    {
      "id": "upstash-context-7-mcp",
      "label": "Context7 via Smithery (HTTP) — remote alternative",
      "transport": "http",
      "url": "https://server.smithery.ai/@upstash/context7-mcp/mcp",
      "headers": {},
      "env": [],
      "agents": ["codex"]
    },
    {
      "id": "taskmaster",
      "label": "Task Master MCP — task orchestration (Claude gets it via plugin)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "--package=task-master-ai", "task-master-mcp"],
      "env": [],
      "agents": ["codex"],
      "overrides": {
        "codex": {
          "extra": {
            "startup_timeout_sec": 120,
            "tools": { "set_task_status": { "approval_mode": "approve" } }
          }
        }
      }
    },
    {
      "id": "lottiefiles-creator",
      "label": "LottieFiles Creator — Lottie animations",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@lottiefiles/creator-mcp@latest"],
      "env": []
    },
    {
      "id": "n8n-mcp",
      "label": "n8n-mcp — build, validate & manage n8n workflows",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "n8n-mcp@latest"],
      "env": ["N8N_API_URL", "N8N_API_KEY"]
    },
    {
      "id": "pencil",
      "label": "Pencil — .pen design editor (Windows desktop app)",
      "transport": "stdio",
      "command": "C:\\Program Files\\Pencil\\resources\\app.asar.unpacked\\out\\mcp-server-windows-x64.exe",
      "args": ["--app", "desktop", "--agent", "claudeCodeCLI"],
      "env": [],
      "overrides": {
        "codex": { "args": ["--app", "desktop", "--agent", "codexCLI"] },
        "opencode": { "args": ["--app", "desktop", "--agent", "openCodeCLI"] }
      }
    },
    {
      "id": "stitch",
      "label": "Stitch (Google) — design-to-code",
      "transport": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": { "X-Goog-Api-Key": "${STITCH_API_KEY}" },
      "env": ["STITCH_API_KEY"],
      "agents": ["claude-code"]
    }
  ],
  "skills": [
    {
      "id": "anti-ai-slop",
      "label": "Anti-AI-Slop — premium landing/UI design (PT)",
      "source": "local",
      "skill": "anti-ai-slop"
    },
    {
      "id": "prd",
      "label": "PRD — generate product requirements docs",
      "source": "local",
      "skill": "prd"
    },
    {
      "id": "impeccable",
      "label": "Impeccable — frontend design/UX system (npm, installs hooks + agents)",
      "source": "npm:impeccable",
      "skill": "impeccable",
      "installer": {
        "cmd": "npx",
        "args": ["--yes", "impeccable@latest", "install", "--scope={scope}", "--providers={provider}", "-y"],
        "providers": { "claude-code": "claude", "codex": "codex" }
      }
    },
    {
      "id": "find-skills",
      "label": "Find Skills — discover/install skills from the open ecosystem",
      "source": "local",
      "skill": "find-skills"
    },
    {
      "id": "shadcn",
      "label": "shadcn — manage shadcn/ui components, registries & presets",
      "source": "local",
      "skill": "shadcn"
    },
    {
      "id": "grill-me",
      "label": "Grill Me — relentless plan/design interview until shared understanding",
      "source": "local",
      "skill": "grill-me"
    },
    {
      "id": "grill-with-docs",
      "label": "Grill With Docs — plan grilling that updates CONTEXT.md/ADRs inline",
      "source": "local",
      "skill": "grill-with-docs"
    },
    {
      "id": "paperclip-create-agent",
      "label": "Paperclip Create Agent — governance-aware agent hiring",
      "source": "local",
      "skill": "paperclip-create-agent"
    },
    {
      "id": "archify",
      "label": "Archify — architecture/workflow/sequence diagrams as standalone HTML (v2.12, MIT)",
      "source": "tt-a1i/archify",
      "skill": "archify",
      "requires": ["Node >= 18"]
    },
    {
      "id": "computer-use",
      "label": "Computer Use — drive desktop app windows via accessibility tree (requires Orca app)",
      "source": "local",
      "skill": "computer-use",
      "requires": ["Orca desktop app (`orca` on PATH)"]
    },
    {
      "id": "orca-cli",
      "label": "Orca CLI — worktrees, terminals & embedded browser (requires Orca app)",
      "source": "local",
      "skill": "orca-cli",
      "requires": ["Orca desktop app (`orca` on PATH)"]
    },
    {
      "id": "orchestration",
      "label": "Orchestration — multi-agent coordination, task DAGs & decision gates (requires Orca app)",
      "source": "local",
      "skill": "orchestration",
      "requires": ["Orca desktop app (`orca` on PATH)"]
    }
  ],
  "subagents": [
    {
      "id": "documentation-auditor",
      "label": "Documentation Auditor — audits docs vs codebase",
      "file": "documentation-auditor.md",
      "codex_file": "documentation-auditor.toml"
    },
    {
      "id": "impeccable-manual-edit-applier",
      "label": "Impeccable Manual Edit Applier — applies leased Impeccable copy-edit batches",
      "file": "impeccable-manual-edit-applier.md",
      "codex_file": "impeccable-manual-edit-applier.toml"
    }
  ],
  "plugins": [
    {
      "id": "claude-official",
      "label": "Claude official: context7, github, frontend-design, playwright",
      "marketplace": "anthropics/claude-plugins-official",
      "name": "claude-plugins-official",
      "install": ["context7", "github", "frontend-design", "playwright"]
    },
    {
      "id": "n8n-mcp-skills",
      "label": "n8n-mcp skills pack",
      "agents": ["claude-code"],
      "marketplace": "czlonkowski/n8n-skills",
      "name": "n8n-mcp-skills",
      "install": ["n8n-mcp-skills"]
    },
    {
      "id": "openai-codex",
      "label": "OpenAI Codex plugin (codex rescue/setup)",
      "marketplace": "openai/codex-plugin-cc",
      "name": "openai-codex",
      "install": ["codex"]
    },
    {
      "id": "taskmaster",
      "label": "Task Master — task orchestration",
      "marketplace": "eyaltoledano/claude-task-master",
      "name": "taskmaster",
      "install": ["taskmaster"]
    },
    {
      "id": "obsidian-skills",
      "label": "Obsidian skills (kepano)",
      "marketplace": "kepano/obsidian-skills",
      "name": "obsidian-skills",
      "install": ["obsidian"]
    },
    {
      "id": "claude-code-warp",
      "label": "Warp for Claude Code",
      "agents": ["claude-code"],
      "marketplace": "warpdotdev/claude-code-warp",
      "name": "claude-code-warp",
      "install": ["warp"]
    },
    {
      "id": "codex-openai-curated",
      "label": "Codex curated connectors: github, gmail, calendar, drive, notion, atlassian, cloudflare, web apps, security",
      "agents": ["codex"],
      "builtin": true,
      "name": "openai-curated",
      "install": [
        "github",
        "gmail",
        "google-calendar",
        "google-drive",
        "notion",
        "atlassian-rovo",
        "cloudflare",
        "build-web-apps",
        "codex-security"
      ]
    },
    {
      "id": "codex-openai-bundled",
      "label": "Codex bundled: computer-use, chrome, browser, sites, visualize, app tools",
      "agents": ["codex"],
      "builtin": true,
      "name": "openai-bundled",
      "install": ["computer-use", "chrome", "browser", "sites", "visualize", "codex-app-tools"]
    },
    {
      "id": "codex-openai-primary-runtime",
      "label": "Codex runtime: documents, spreadsheets, presentations, pdf, template-creator",
      "agents": ["codex"],
      "builtin": true,
      "name": "openai-primary-runtime",
      "install": ["documents", "spreadsheets", "presentations", "pdf", "template-creator"]
    }
  ],
  "presets": [
    {
      "id": "claude-settings",
      "label": "Claude settings — Fable 5.1 [1m], xhigh effort, thinking, agent teams, auto mode, permissions, voice, status line",
      "agents": ["claude-code"],
      "files": [
        { "op": "merge-json", "asset": "presets/claude/settings.json", "dest": "~/.claude/settings.json" },
        { "op": "copy", "asset": "presets/claude/statusline-command.sh", "dest": "~/.claude/statusline-command.sh" },
        { "op": "copy", "asset": "presets/claude/statusline-data.py", "dest": "~/.claude/statusline-data.py" }
      ]
    },
    {
      "id": "codex-config",
      "label": "Codex config — gpt-6-astra, xhigh, pragmatic, on-request approvals, workspace-write + network, multi-agent, memories",
      "agents": ["codex"],
      "files": [
        { "op": "merge-toml", "asset": "presets/codex/config.toml", "dest": "~/.codex/config.toml" }
      ]
    },
    {
      "id": "codex-global-instructions",
      "label": "Codex global AGENTS.md — Clean Code for Agents (kept if one exists)",
      "agents": ["codex"],
      "files": [
        { "op": "copy", "asset": "templates/clean-code-for-agents.md", "dest": "~/.codex/AGENTS.md", "keep": true }
      ]
    }
  ],
  "templates": {
    "claude_md": "templates/clean-code-for-agents.md",
    "agents_md": "templates/clean-code-for-agents.md",
    "memory": "templates/memory.md"
  },
  "gitignore": [
    ".claude/settings.local.json",
    ".codex/hooks.json",
    ".impeccable/config.local.json",
    ".opencode/cache/",
    ".agent-harness/"
  ]
}
