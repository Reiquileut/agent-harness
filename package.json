{
  "name": "@r2t/agent-harness",
  "version": "1.6.0",
  "description": "Dotfiles-for-AI-agents bootstrapper: one command to configure MCPs, skills, plugins, custom agents, settings presets and integrations across Claude Code, Codex, and OpenCode — with private overlays and a one-command Ubuntu bootstrap.",
  "type": "module",
  "bin": {
    "agent-harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc",
    "test": "bash scripts/ci-e2e.sh",
    "prepack": "tsup",
    "start": "node dist/cli.js",
    "test:hooks": "node --test assets/hooks/claude/bloquear-mencao-claude-commit.test.ts",
    "guard": "node scripts/guard-no-private.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "opencode",
    "mcp",
    "skills",
    "cli",
    "bootstrap",
    "dotfiles"
  ],
  "author": "reiquileut",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
